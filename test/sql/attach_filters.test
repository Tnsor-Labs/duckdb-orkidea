ATTACH 'ora' AS o (TYPE orkidea, READ_ONLY);

# DuckDB evaluates every filter on this copy itself.
statement ok
CREATE TABLE local_copy AS FROM orkidea_query('ora', 'SELECT * FROM ORKIDEA_DUCK_FILTERS');

