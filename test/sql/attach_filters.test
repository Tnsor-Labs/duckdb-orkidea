FROM orkidea_execute('ora', 'CREATE TABLE ORKIDEA_DUCK_FILTERS (id NUMBER(10), n NUMBER(12,3), nu NUMBER, bd BINARY_DOUBLE, bf BINARY_FLOAT, vc VARCHAR2(20), nv NVARCHAR2(20), ch CHAR(5), d DATE, ts TIMESTAMP(6), tstz TIMESTAMP(6) WITH TIME ZONE, tsltz TIMESTAMP WITH LOCAL TIME ZONE, r RAW(8), b BOOLEAN, cl CLOB)');

