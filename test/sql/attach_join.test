# With Oracle statistics, a join that keeps as many rows as its largest table
# stays in DuckDB, which reads the tables in parallel, and an aggregate over
# it runs in Oracle when it has fewer groups than half of those rows.
statement ok
FROM orkidea_execute('ora', 'CREATE TABLE orkidea_jp_fact (n NUMBER(6), k NUMBER(3))');

statement ok
FROM orkidea_execute('ora', 'CREATE TABLE orkidea_jp_dim (k NUMBER(3), name VARCHAR2(10))');

statement ok
FROM orkidea_execute('ora', 'BEGIN INSERT INTO orkidea_jp_fact SELECT level, MOD(level, 10) FROM dual CONNECT BY level <= 1000; INSERT INTO orkidea_jp_dim SELECT level - 1, ''k'' || (level - 1) FROM dual CONNECT BY level <= 10; COMMIT; DBMS_STATS.GATHER_TABLE_STATS(USER, ''ORKIDEA_JP_FACT''); DBMS_STATS.GATHER_TABLE_STATS(USER, ''ORKIDEA_JP_DIM''); END;');

statement ok
ATTACH 'ora' AS s (TYPE orkidea);

query II
EXPLAIN SELECT f.n, d.name FROM s.orkidea_jp_fact f JOIN s.orkidea_jp_dim d ON f.k = d.k;
