# name: test/sql/attach_join.test
# description: Joins of tables of one attached Oracle database run in Oracle, with the results DuckDB gives; joins Oracle cannot compute exactly stay in DuckDB.
# group: [sql]

require orkidea

require-env ORKIDEA_TEST_URI

statement ok
CREATE SECRET ora (TYPE orkidea, URI '{ORKIDEA_TEST_URI}');

statement ok
FROM orkidea_execute('ora', 'BEGIN FOR t IN (SELECT table_name FROM user_tables WHERE table_name LIKE ''ORKIDEA\_JP\_%'' ESCAPE ''\'') LOOP EXECUTE IMMEDIATE ''DROP TABLE "'' || t.table_name || ''" PURGE''; END LOOP; END;');

statement ok
FROM orkidea_execute('ora', 'CREATE TABLE orkidea_jp_a (id NUMBER, k NUMBER(5), d DATE, s VARCHAR2(10), ns NVARCHAR2(10), c CHAR(3), amt NUMBER(10,2), b BOOLEAN, f BINARY_DOUBLE)');

statement ok
FROM orkidea_execute('ora', 'INSERT INTO orkidea_jp_a VALUES (1, 1, DATE ''2025-01-01'', ''a'', N''a'', ''a'', 1.5, TRUE, 1.5)');

statement ok
FROM orkidea_execute('ora', 'INSERT INTO orkidea_jp_a VALUES (2, 2, DATE ''2025-01-02'', ''b'', N''b'', ''b'', 2.25, FALSE, 2)');

statement ok
FROM orkidea_execute('ora', 'INSERT INTO orkidea_jp_a VALUES (3, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL)');

statement ok
FROM orkidea_execute('ora', 'INSERT INTO orkidea_jp_a VALUES (4, 4, DATE ''2025-01-04'', ''dd'', N''dd'', ''d'', 4, TRUE, 4)');

statement ok
FROM orkidea_execute('ora', 'INSERT INTO orkidea_jp_a VALUES (4, 4, DATE ''2025-01-04'', ''dd'', N''dd'', ''d'', 4, TRUE, 4)');

statement ok
FROM orkidea_execute('ora', 'INSERT INTO orkidea_jp_a VALUES (5, 5, DATE ''2025-01-05'', ''é'', N''é'', ''e'', 5, FALSE, BINARY_DOUBLE_NAN)');

statement ok
FROM orkidea_execute('ora', 'INSERT INTO orkidea_jp_a VALUES (6, 7, DATE ''2025-01-06'', ''f'', N''f'', ''f'', 6, NULL, 6)');

statement ok
FROM orkidea_execute('ora', 'CREATE TABLE orkidea_jp_b (id NUMBER(19), ts TIMESTAMP(3), s VARCHAR2(20), ns NVARCHAR2(5), f BINARY_DOUBLE, a_k NUMBER(9))');

statement ok
FROM orkidea_execute('ora', 'INSERT INTO orkidea_jp_b VALUES (1, TIMESTAMP ''2025-01-01 00:00:00'', ''a'', N''a'', 1.5, 1)');

statement ok
FROM orkidea_execute('ora', 'INSERT INTO orkidea_jp_b VALUES (2, TIMESTAMP ''2025-01-02 00:00:00.5'', ''b'', N''b'', 2, 2)');

statement ok
FROM orkidea_execute('ora', 'INSERT INTO orkidea_jp_b VALUES (2, TIMESTAMP ''2025-01-02 00:00:00'', ''bb'', N''bb'', 2, 2)');

statement ok
FROM orkidea_execute('ora', 'INSERT INTO orkidea_jp_b VALUES (4, TIMESTAMP ''2025-01-04 00:00:00'', ''dd'', N''dd'', 4, 4)');

statement ok
FROM orkidea_execute('ora', 'INSERT INTO orkidea_jp_b VALUES (5, TIMESTAMP ''2025-01-05 12:00:00'', ''é'', N''é'', BINARY_DOUBLE_NAN, 5)');

statement ok
FROM orkidea_execute('ora', 'INSERT INTO orkidea_jp_b VALUES (7, NULL, ''zz'', NULL, NULL, NULL)');

statement ok
FROM orkidea_execute('ora', 'INSERT INTO orkidea_jp_b VALUES (NULL, NULL, NULL, NULL, NULL, NULL)');

statement ok
FROM orkidea_execute('ora', 'CREATE TABLE orkidea_jp_c (k NUMBER(5), label VARCHAR2(10))');

statement ok
FROM orkidea_execute('ora', 'INSERT INTO orkidea_jp_c VALUES (1, ''one'')');

statement ok
FROM orkidea_execute('ora', 'INSERT INTO orkidea_jp_c VALUES (2, ''two'')');

