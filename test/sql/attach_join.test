# Oracle compares NUMBER keys exactly: two that read as the same DOUBLE
# match in DuckDB, which compares them rounded, and not in Oracle.
statement ok
FROM orkidea_execute('ora', 'CREATE TABLE orkidea_jp_big (id NUMBER)');

