statement ok
ATTACH 'ora' AS o (TYPE orkidea);

statement ok
ATTACH 'ora' AS o2 (TYPE orkidea);

statement ok
CREATE TABLE local AS SELECT * FROM (VALUES (1, 'x'), (4, 'y')) t(id, v);

# NUMBER and NUMBER(19) keys, which DuckDB casts to DOUBLE.
statement ok
SET orkidea_join_pushdown = false;

statement ok
CREATE OR REPLACE TABLE expected AS SELECT a.id, a.s, b.ts FROM o.orkidea_jp_a a JOIN o.orkidea_jp_b b ON a.id = b.id;

statement ok
RESET orkidea_join_pushdown;

query II
EXPLAIN SELECT a.id, a.s, b.ts FROM o.orkidea_jp_a a JOIN o.orkidea_jp_b b ON a.id = b.id;
----
physical_plan	<REGEX>:.*Orkidea Remote Query.*

query II
SELECT (SELECT count(*) FROM (SELECT a.id, a.s, b.ts FROM o.orkidea_jp_a a JOIN o.orkidea_jp_b b ON a.id = b.id EXCEPT ALL FROM expected)), (SELECT count(*) FROM (FROM expected EXCEPT ALL SELECT a.id, a.s, b.ts FROM o.orkidea_jp_a a JOIN o.orkidea_jp_b b ON a.id = b.id));
----
0	0

query I
SELECT count(*) FROM expected;
----
6

# Filters on both sides.
statement ok
SET orkidea_join_pushdown = false;

statement ok
CREATE OR REPLACE TABLE expected AS SELECT a.id, b.s FROM o.orkidea_jp_a a JOIN o.orkidea_jp_b b ON a.id = b.id WHERE a.amt > 1 AND b.s <> 'zz';

statement ok
RESET orkidea_join_pushdown;

query II
EXPLAIN SELECT a.id, b.s FROM o.orkidea_jp_a a JOIN o.orkidea_jp_b b ON a.id = b.id WHERE a.amt > 1 AND b.s <> 'zz';
----
physical_plan	<REGEX>:.*Orkidea Remote Query.*

query II
SELECT (SELECT count(*) FROM (SELECT a.id, b.s FROM o.orkidea_jp_a a JOIN o.orkidea_jp_b b ON a.id = b.id WHERE a.amt > 1 AND b.s <> 'zz' EXCEPT ALL FROM expected)), (SELECT count(*) FROM (FROM expected EXCEPT ALL SELECT a.id, b.s FROM o.orkidea_jp_a a JOIN o.orkidea_jp_b b ON a.id = b.id WHERE a.amt > 1 AND b.s <> 'zz'));
----
0	0

query I
SELECT count(*) FROM expected;
----
