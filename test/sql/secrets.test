# name: test/sql/secrets.test
# description: Creating orkidea secrets, and resolving connection targets, without a database.
# group: [sql]

require orkidea

statement ok
CREATE SECRET ora (TYPE orkidea, HOST 'db.example.com', PORT 1521, SERVICE 'FREEPDB1', USER 'scott', PASSWORD 'tiger');

query II
SELECT type, provider FROM duckdb_secrets() WHERE name = 'ora';
----
orkidea	config

# The password never shows.
query I
SELECT secret_string LIKE '%password=redacted%' AND secret_string NOT LIKE '%tiger%' FROM duckdb_secrets() WHERE name = 'ora';
----
true

statement ok
CREATE SECRET ora_uri (TYPE orkidea, URI 'oracle://scott:tiger@db.example.com/FREEPDB1');

query I
SELECT secret_string NOT LIKE '%tiger%' FROM duckdb_secrets() WHERE name = 'ora_uri';
----
true

statement ok
CREATE SECRET ora_tns (TYPE orkidea, CONNECT_STRING 'sales', CONFIG_DIR '/etc/oracle', USERNAME 'scott');

statement error
CREATE SECRET bad (TYPE orkidea, USER 'scott');
----
needs HOST, CONNECT_STRING, or URI

statement error
CREATE SECRET bad (TYPE orkidea, HOST 'db', CONNECT_STRING 'db/svc');
----
HOST or CONNECT_STRING, not both

statement error
CREATE SECRET bad (TYPE orkidea, CONNECT_STRING 'db/svc', PORT 1521);
----
The PORT of an orkidea secret needs a HOST

statement error
CREATE SECRET bad (TYPE orkidea, HOST 'db', PROTOCOL 'udp');
----
is TCP or TCPS

statement error
CREATE SECRET bad (TYPE orkidea, HOST 'db', COLOUR 'blue');
----
Unknown parameter "colour"

statement error
SELECT * FROM orkidea_query('missing', 'SELECT 1 FROM dual');
----
No secret named 'missing'

statement ok
CREATE SECRET other (TYPE http, BEARER_TOKEN 'x');

statement error
SELECT * FROM orkidea_query('other', 'SELECT 1 FROM dual');
----
is of type http, not orkidea

statement error
SELECT * FROM orkidea_query(NULL, 'SELECT 1 FROM dual');
----
must not be NULL

statement error
SELECT * FROM orkidea_execute('ora', NULL);
----
must not be NULL

# Nothing listens on port 1.
statement error
SELECT * FROM orkidea_query('oracle://scott:tiger@127.0.0.1:1/FREEPDB1', 'SELECT 1 FROM dual');
----
Orkidea: connecting failed

statement ok
SET enable_external_access = false;

statement error
SELECT * FROM orkidea_query('ora', 'SELECT 1 FROM dual');
----
disabled by the enable_external_access setting
